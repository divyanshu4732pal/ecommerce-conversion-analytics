                <zone fixed-size='192' h='22222' id='9' is-fixed='true' name='Purchase Rate by Session Duration' w='49429' x='571' y='37667'>
                  <layout-cache fixed-size-h='218' minwidth='180' type-h='fixed' type-w='scalable' />
                  <zone-style>
