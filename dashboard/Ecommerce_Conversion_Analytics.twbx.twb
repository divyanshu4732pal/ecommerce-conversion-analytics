  <dashboards>
    <dashboard enable-sort-zone-taborder='true' name='Behavioral Insights'>
      <style />
      <size maxheight='900' maxwidth='1400' minheight='900' minwidth='1400' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='4555' id='5' type-v2='text' w='98858' x='571' y='889'>
            <formatted-text>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='26'>Behavioral Drivers of Conversion</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='23445' id='6' param='horz' type-v2='layout-flow' w='98858' x='571' y='14222'>
            <zone h='23445' id='7' name='Purchase Rate by Unique Products Viewed' w='98858' x='571' y='14222'>
              <layout-cache minwidth='200' type-h='fixed' type-w='scalable' />
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone h='22222' id='8' param='horz' type-v2='layout-flow' w='98858' x='571' y='37667'>
            <zone h='22222' id='9' name='Purchase Rate by Session Duration' w='49429' x='571' y='37667'>
              <layout-cache fixed-size-h='218' minwidth='180' type-h='fixed' type-w='scalable' />
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='22222' id='10' name='Purchase Rate by Post-Cart Product Revisits' w='49429' x='50000' y='37667'>
              <layout-cache minwidth='180' type-h='fixed' type-w='scalable' />
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone h='39222' id='11' param='vert' type-v2='layout-flow' w='98858' x='571' y='59889'>
            <zone fixed-size='213' h='24556' id='12' is-fixed='true' name='Purchase Rate by Browsing Focus' w='98858' x='571' y='59889'>
              <layout-cache type-h='fixed' type-w='fixed' />
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone forceUpdate='true' h='9667' id='13' type-v2='text' w='98858' x='571' y='84445'>
              <formatted-text>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Key Insights</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'>Product exploration is the strongest predictor: 0.5% → 31.7% purchase rate from 1 to 16+ products viewed</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'>Focus ratio is U-shaped, not linear: both very low (11.0%) and very high (9.1%) focus outperform mid-range (1.3%) — broad comparison and decisive buying both beat indecisive browsing</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'>Duration and post-cart revisits trend the same direction, but likely reflect general engagement rather than independent drivers</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'>Takeaway: broad exploration or clear intent both convert well — narrow, hesitant browsing is the weak spot to target</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone h='8778' id='20' param='horz' type-v2='layout-flow' w='24429' x='75000' y='5444' />
          <zone h='8778' id='21' param='horz' type-v2='layout-flow' w='27786' x='47214' y='5444'>
